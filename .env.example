# ─── CONFIGURACIÓN DE SUPABASE ────────────────────────────────────────────────
# URL de tu proyecto en Supabase (ej: https://xyzcompany.supabase.co)
VITE_SUPABASE_URL=https://tu-proyecto.supabase.co

# Clave pública Anon (para la app web del frontend)
VITE_SUPABASE_ANON_KEY=tu-anon-public-key

# Clave secreta Service Role (Solo para scripts administrativos como importación de Notion)
# La encuentras en Supabase -> Project Settings -> API -> service_role secret
SUPABASE_SERVICE_ROLE_KEY=tu-service-role-secret-key

# ─── CONFIGURACIÓN DE GROQ IA ────────────────────────────────────────────────
# Clave de API de Groq (para Edge Functions de sugerencia pastoral)
GROQ_API_KEY=gsk_tu_clave_de_groq
